{
  "name": "travel-tierlist",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-travel-tierlist 'node --test tests/rules/*.test.js'",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "cloud:member": "node scripts/grant-access.mjs",
    "cloud:deploy": "firebase deploy --only firestore:rules --project travel-tiers"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "firebase": "^13.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "firebase-admin": "^13.0.0",
    "firebase-tools": "^15.0.0",
    "vite": "^8.3.5"
  }
}
